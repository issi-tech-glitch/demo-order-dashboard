{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", "group:allNonMajor"],
  "timezone": "Europe/Berlin",
  "schedule": ["* 0-5 * * 1"],
  "minimumReleaseAge": "7 days",
  "platformAutomerge": false,
  "automergeType": "pr",
  "labels": ["dependencies"],
  "lockFileMaintenance": {
    "enabled": true,
    "automerge": true
  },
  "packageRules": [
    {
      "description": "Kleine Updates nach bestandener CI automatisch übernehmen",
      "matchUpdateTypes": ["minor", "patch", "pin", "digest", "lockFileMaintenance"],
      "automerge": true
    },
    {
      "description": "Große Updates nie automatisch",
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "labels": ["dependencies", "major-update"]
    },
    {
      "description": "Neue Python-Version (z.B. 3.12 -> 3.13) im Basis-Image selbst entscheiden",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["python"],
      "matchUpdateTypes": ["minor"],
      "groupName": "Python-Basis-Image",
      "automerge": false,
      "labels": ["dependencies", "major-update"]
    }
  ]
}
